<!doctype html><html lang="ja"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><link rel="stylesheet" href="/style.css"><title>賃貸物件登録</title></head><body><main class="wrap"><h1><%= p?'賃貸物件の編集':'賃貸物件の追加' %></h1><a href="/admin">← 物件一覧へ</a><form class="panel" action="<%= action %>" method="post" enctype="multipart/form-data"><div class="grid"><label>物件番号<input name="propertyNo" type="text" value="<%= p?.propertyNo ?? '' %>"></label><label>物件名 *<input name="title" type="text" value="<%= p?.title ?? '' %>"></label><label>用途<select name="category"><option value="居住用" <%= p?.category==="居住用"?"selected":"" %>>居住用</option><option value="事業用" <%= p?.category==="事業用"?"selected":"" %>>事業用</option></select></label><label>物件種別<select name="type"><option value="賃貸マンション" <%= p?.type==="賃貸マンション"?"selected":"" %>>賃貸マンション</option><option value="賃貸アパート" <%= p?.type==="賃貸アパート"?"selected":"" %>>賃貸アパート</option><option value="賃貸戸建" <%= p?.type==="賃貸戸建"?"selected":"" %>>賃貸戸建</option><option value="テラスハウス" <%= p?.type==="テラスハウス"?"selected":"" %>>テラスハウス</option><option value="貸店舗" <%= p?.type==="貸店舗"?"selected":"" %>>貸店舗</option><option value="貸事務所" <%= p?.type==="貸事務所"?"selected":"" %>>貸事務所</option><option value="貸倉庫" <%= p?.type==="貸倉庫"?"selected":"" %>>貸倉庫</option><option value="貸地" <%= p?.type==="貸地"?"selected":"" %>>貸地</option></select></label><label>家賃（円/月）*<input name="price" type="number" value="<%= p?.price ?? '' %>"></label><label>管理費・共益費（円/月）<input name="managementFee" type="number" value="<%= p?.managementFee ?? '' %>"></label><label>敷金<input name="deposit" type="text" value="<%= p?.deposit ?? '' %>"></label><label>礼金<input name="keyMoney" type="text" value="<%= p?.keyMoney ?? '' %>"></label><label>保証金<input name="guarantee" type="text" value="<%= p?.guarantee ?? '' %>"></label><label>更新料<input name="renewalFee" type="text" value="<%= p?.renewalFee ?? '' %>"></label><label>契約期間<input name="contractTerm" type="text" value="<%= p?.contractTerm ?? '' %>"></label><label>入居可能日<input name="availableDate" type="text" value="<%= p?.availableDate ?? '' %>"></label><label>募集区分・掲載元<input name="listingSource" type="text" value="<%= p?.listingSource ?? '' %>"></label><label>都道府県<input name="prefecture" type="text" value="<%= p?.prefecture ?? '千葉県' %>"></label><label>市区町村 *<input name="city" type="text" value="<%= p?.city ?? '' %>"></label><label>町名番地 *<input name="address" type="text" value="<%= p?.address ?? '' %>"></label><label>最寄駅<input name="station" type="text" value="<%= p?.station ?? '' %>"></label><label>徒歩分数<input name="walkMinutes" type="number" value="<%= p?.walkMinutes ?? '' %>"></label><label>間取り<input name="layout" type="text" value="<%= p?.layout ?? '' %>"></label><label>面積㎡<input name="area" type="number" value="<%= p?.area ?? '' %>"></label><label>築年月<input name="built" type="text" value="<%= p?.built ?? '' %>"></label><label>構造<input name="structure" type="text" value="<%= p?.structure ?? '' %>"></label><label>所在階<input name="floor" type="text" value="<%= p?.floor ?? '' %>"></label><label>駐車場<input name="parking" type="text" value="<%= p?.parking ?? '' %>"></label><label>取引態様<input name="transaction" type="text" value="<%= p?.transaction ?? '' %>"></label><label>公開状態<select name="status"><option value="公開" <%= p?.status==="公開"?"selected":"" %>>公開</option><option value="非公開" <%= p?.status==="非公開"?"selected":"" %>>非公開</option><option value="募集終了" <%= p?.status==="募集終了"?"selected":"" %>>募集終了</option></select></label><label><input type="checkbox" style="width:auto" name="pets" <%= p?.pets?"checked":"" %>> ペット可</label><label><input type="checkbox" style="width:auto" name="garden" <%= p?.garden?"checked":"" %>> 庭付き</label><label><input type="checkbox" style="width:auto" name="featured" <%= p?.featured?"checked":"" %>> おすすめ</label><label><input type="checkbox" style="width:auto" name="adPermission" <%= p?.adPermission?"checked":"" %>> 広告掲載許諾確認済み</label><label>物件説明<textarea name="description"><%= p?.description||"" %></textarea></label><label>おすすめポイント<textarea name="highlights"><%= p?.highlights||"" %></textarea></label><label>物件写真<input type="file" name="photos" accept="image/jpeg,image/png,image/webp" multiple></label><label>間取り図<input type="file" name="floorplans" accept="image/jpeg,image/png,image/webp" multiple></label><label>360度写真<input type="file" name="panoramas" accept="image/jpeg,image/png,image/webp" multiple></label></div><button>保存する</button></form><h2>登録済み画像</h2><div class="grid"><% ['photos','floorplans','panoramas'].forEach(k=>(p?.[k]||[]).forEach(f=>{ %><div class="card"><img src="/uploads/<%= f %>" style="width:100%"><form method="post" action="/admin/properties/<%= p.id %>/image-delete"><input type="hidden" name="type" value="<%= k %>"><input type="hidden" name="filename" value="<%= f %>"><button>画像削除</button></form></div><% })) %></div></main></body></html>