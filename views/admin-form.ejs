<!doctype html><html lang="ja"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><link rel="stylesheet" href="/style.css"><title>賃貸物件登録</title></head><body><main class="wrap"><h1><%= p?'賃貸物件の編集':'賃貸物件の追加' %></h1><a href="/admin">← 物件一覧へ</a><form class="panel" action="<%= action %>" method="post" enctype="multipart/form-data"><div class="grid"><label>物件番号<input name="propertyNo" type="text" value="<%= p?.propertyNo ?? '' %>"></label><label>物件名 *<input name="title" type="text" value="<%= p?.title ?? '' %>"></label><label>用途<select name="category"><option value="居住用" <%= p?.category==="居住用"?"selected":"" %>>居住用</option><option value="事業用" <%= p?.category==="事業用"?"selected":"" %>>事業用</option></select></label><label>物件種別<select name="type"><option value="賃貸マンション" <%= p?.type==="賃貸マンション"?"selected":"" %>>賃貸マンション</option><option value="賃貸アパート" <%= p?.type==="賃貸アパート"?"selected":"" %>>賃貸アパート</option><option value="賃貸戸建" <%= p?.type==="賃貸戸建"?"selected":"" %>>賃貸戸建</option><option value="テラスハウス" <%= p?.type==="テラスハウス"?"selected":"" %>>テラスハウス</option><option value="貸店舗" <%= p?.type==="貸店舗"?"selected":"" %>>貸店舗</option><option value="貸事務所" <%= p?.type==="貸事務所"?"selected":"" %>>貸事務所</option><option value="貸倉庫" <%= p?.type==="貸倉庫"?"selected":"" %>>貸倉庫</option><option value="貸地" <%= p?.type==="貸地"?"selected":"" %>>貸地</option></select></label><label>家賃（円/月）*<input name="price" type="number" value="<%= p?.price ?? '' %>"></label><label>管理費・共益費（円/月）<input name="managementFee" type="number" value="<%= p?.managementFee ?? '' %>"></label><label>敷金<input name="deposit" type="text" value="<%= p?.deposit ?? '' %>"></label><label>礼金<input name="keyMoney" type="text" value="<%= p?.keyMoney ?? '' %>"></label><label>保証金<input name="guarantee" type="text" value="<%= p?.guarantee ?? '' %>"></label><label>更新料<input name="renewalFee" type="text" value="<%= p?.renewalFee ?? '' %>"></label><label>契約期間<input name="contractTerm" type="text" value="<%= p?.contractTerm ?? '' %>"></label><label>入居可能日<input name="availableDate" type="text" value="<%= p?.availableDate ?? '' %>"></label><label>募集区分・掲載元<input name="listingSource" type="text" value="<%= p?.listingSource ?? '' %>"></label><label>都道府県<input name="prefecture" type="text" value="<%= p?.prefecture ?? '千葉県' %>"></label><label>市区町村 *<input name="city" type="text" value="<%= p?.city ?? '' %>"></label><label>町名番地 *<input name="address" type="text" value="<%= p?.address ?? '' %>"></label><label>最寄駅<input name="station" type="text" value="<%= p?.station ?? '' %>"></label><label>徒歩分数<input name="walkMinutes" type="number" value="<%= p?.walkMinutes ?? '' %>"></label><label>間取り<input name="layout" type="text" value="<%= p?.layout ?? '' %>"></label><label>面積㎡<input name="area" type="number" value="<%= p?.area ?? '' %>"></label><label>築年月<input name="built" type="text" value="<%= p?.built ?? '' %>"></label><label>構造<input name="structure" type="text" value="<%= p?.structure ?? '' %>"></label><label>所在階<input name="floor" type="text" value="<%= p?.floor ?? '' %>"></label><label>駐車場<input name="parking" type="text" value="<%= p?.parking ?? '' %>"></label><label>取引態様<input name="transaction" type="text" value="<%= p?.transaction ?? '' %>"></label><label>公開状態<select name="status"><option value="公開" <%= p?.status==="公開"?"selected":"" %>>公開</option><option value="非公開" <%= p?.status==="非公開"?"selected":"" %>>非公開</option><option value="募集終了" <%= p?.status==="募集終了"?"selected":"" %>>募集終了</option></select></label><label><input type="checkbox" style="width:auto" name="pets" <%= p?.pets?"checked":"" %>> ペット可</label><label><input type="checkbox" style="width:auto" name="garden" <%= p?.garden?"checked":"" %>> 庭付き</label><label><input type="checkbox" style="width:auto" name="featured" <%= p?.featured?"checked":"" %>> おすすめ</label><label><input type="checkbox" style="width:auto" name="adPermission" <%= p?.adPermission?"checked":"" %>> 広告掲載許諾確認済み</label><label>物件説明<textarea name="description"><%= p?.description||"" %></textarea></label><label>おすすめポイント<textarea name="highlights"><%= p?.highlights||"" %></textarea></label><label>物件写真<input type="file" name="photos" accept="image/jpeg,image/png,image/webp" multiple></label><label>間取り図<input type="file" name="floorplans" accept="image/jpeg,image/png,image/webp" multiple></label><label>360度写真<input type="file" name="panoramas" accept="image/jpeg,image/png,image/webp" multiple></label></div>
<section class="panel" style="margin:20px 0;padding:18px;border:1px solid #d9e8df;border-radius:12px;background:#f6faf7">
<h2 style="margin-top:0">周辺施設を自動検索（半径1km）</h2>
<p>登録した住所からスーパー・学校・病院・公園を検索します。距離は直線距離です。</p>
<% if(p?.id){ %>
<button type="button" id="nearby-search" class="btn">周辺施設を検索して保存</button>
<p id="nearby-status" role="status" aria-live="polite">検索前に都道府県・市区町村・町名番地をご確認ください。</p>
<div id="nearby-results"></div>
<% if(Array.isArray(p.facilities) && p.facilities.length){ %>
<h3>現在登録されている施設（<%= p.facilities.length %>件）</h3>
<ul><% p.facilities.slice(0,30).forEach(f=>{ %><li><%= f.category %>：<%= f.name %>（<%= f.distance %>）</li><% }) %></ul>
<% } %>
<% if(p.qchizuMapUrl){ %><p><a href="<%= p.qchizuMapUrl %>" target="_blank" rel="noopener noreferrer">全国Q地図で検索地点を確認</a></p><% } %>
<% } else { %>
<p>最初に物件を保存してください。保存後に編集画面から周辺施設を検索できます。</p>
<% } %>
</section>
<button>保存する</button></form><h2>登録済み画像</h2><div class="grid"><% ['photos','floorplans','panoramas'].forEach(k=>(p?.[k]||[]).forEach(f=>{ %><div class="card"><img src="/uploads/<%= f %>" style="width:100%"><form method="post" action="/admin/properties/<%= p.id %>/image-delete"><input type="hidden" name="type" value="<%= k %>"><input type="hidden" name="filename" value="<%= f %>"><button>画像削除</button></form></div><% })) %></div></main><script>
(() => {
 const button=document.getElementById('nearby-search');
 if(!button)return;
 const status=document.getElementById('nearby-status');
 const results=document.getElementById('nearby-results');
 const form=button.closest('form');
 const id=<%- JSON.stringify(p?.id || '') %>;
 const field=name=>String(form.elements.namedItem(name)?.value||'').trim();
 button.addEventListener('click',async()=>{
  const prefecture=field('prefecture'),city=field('city'),address=field('address');
  if(!prefecture||!city||!address){status.textContent='住所をすべて入力してください。';return;}
  button.disabled=true;results.replaceChildren();status.textContent='検索しています…';
  try{
   const r=await fetch('/admin/nearby-facilities',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({prefecture,city,address})});
   const data=await r.json();
   if(!r.ok)throw Error(data.error||'施設の検索に失敗しました');
   if(!Array.isArray(data.facilities)||!data.facilities.length){status.textContent='該当施設は見つかりませんでした。登録済み施設は変更していません。';return;}
   const list=document.createElement('ul');
   for(const f of data.facilities.slice(0,100)){
    const li=document.createElement('li');li.textContent=[f.category,f.name,f.distance].filter(Boolean).join(' / ');list.appendChild(li);
   }
   results.appendChild(list);
   if(!confirm(data.facilities.length+'件見つかりました。既存の周辺施設情報を置き換えて保存しますか？')){
    status.textContent='保存せずに終了しました。';return;
   }
   const saved=await fetch('/admin/properties/'+encodeURIComponent(id)+'/facilities',{
    method:'POST',headers:{'Content-Type':'application/json'},
    body:JSON.stringify({facilities:data.facilities,qchizuAttribution:data.qchizuAttribution,qchizuMapUrl:data.qchizuMapUrl})
   });
   const response=await saved.json();
   if(!saved.ok)throw Error(response.error||'施設の保存に失敗しました');
   status.textContent=response.count+'件の施設を保存しました。ページを再読み込みすると登録内容を確認できます。';
  }catch(e){status.textContent='エラー：'+e.message;}
  finally{button.disabled=false;}
 });
})();
</script></body></html>
