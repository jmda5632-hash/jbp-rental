<!doctype html>
<html lang="ja">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<%
const city=String(area.city||'');
const town=String(area.town||'');
const listing=Array.isArray(area.properties)?area.properties:[];
const count=listing.length;
const residential=listing.filter(p=>p.category==='居住用').length;
const commercial=listing.filter(p=>p.category==='事業用').length;
// 登録済みの駅名を優先し、交通欄がある場合のみ駅名を抽出する。
function stationName(p){
  const direct=String(p.station||'').trim();
  if(direct)return direct;
  const traffic=String(p.traffic||p.transportation||p.access||p.交通||'').trim();
  if(!traffic)return '';
  const match=traffic.match(/([^\s、,／/「」()（）]{1,35}駅)/);
  return match ? match[1] : '';
}
function stationWalk(p){
  const raw=p.walkMinutes;
  if(raw!==''&&raw!=null&&Number.isFinite(Number(raw))&&Number(raw)>0)return Number(raw);
  const traffic=String(p.traffic||p.transportation||p.access||p.交通||'');
  const match=traffic.match(/徒歩\s*(\d+)\s*分/);
  return match ? Number(match[1]) : null;
}

const canonicalUrl=origin()+url(city,town);
const pageTitle=city+town+'の賃貸物件・貸店舗・貸事務所｜JBP RENTAL';
const pageDescription=city+town+'の賃貸物件を探すならJBP RENTAL。公開中の物件'+count+'件を掲載。マンション・アパート・戸建・店舗・事務所などを確認できます。';
%>
<title><%= pageTitle %></title>
<meta name="description" content="<%= pageDescription %>">
<meta name="robots" content="index,follow">
<link rel="canonical" href="<%= canonicalUrl %>">
<link rel="stylesheet" href="/style.css">
<link rel="stylesheet" href="/jbp-redesign.css">
<style>
.town-seo{margin:28px 0;padding:24px;background:#fff;border:1px solid #dce9e2;border-radius:16px;line-height:1.9}
.town-seo h2{margin-top:0;color:#104b38}
.town-stats{display:flex;gap:12px;flex-wrap:wrap;margin:16px 0}
.town-stats span{background:#edf6f1;border-radius:30px;padding:7px 14px;font-weight:600}
.town-property-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px}
.town-property-grid .card{min-width:0;overflow:hidden}
.town-property-grid .card img{width:100%;aspect-ratio:4/3;object-fit:cover}
.town-property-grid .card h3{overflow-wrap:anywhere}
.town-station{font-weight:600;color:#14513c}
@media(max-width:650px){
.town-property-grid{grid-template-columns:repeat(3,minmax(0,1fr));gap:7px}
.town-property-grid .card{padding:6px;border-radius:9px}
.town-property-grid .card h3{font-size:11px;line-height:1.4}
.town-property-grid .card .price{font-size:13px}
.town-property-grid .card p,.town-property-grid .card .muted{font-size:10px;line-height:1.4}
.town-seo{padding:16px}
}
</style>
</head>
<body>
<header><div class="wrap"><strong>JBP RENTAL｜ジャパンベストパートナーズ株式会社</strong>
<nav><a href="/">ホーム</a><a href="/properties">賃貸物件検索</a><a href="/areas">町名から探す</a><a href="/owners">オーナー様へ</a></nav></div></header>
<main class="wrap">
<nav aria-label="パンくずリスト"><a href="/">ホーム</a> ＞ <a href="/areas">町名から探す</a> ＞ <span><%= city %><%= town %></span></nav>
<h1><%= city %><%= town %>の賃貸物件</h1>
<p><%= city %><%= town %>で公開中の賃貸物件を掲載しています。</p>
<div class="town-stats"><span>掲載 <%= count %>件</span><span>居住用 <%= residential %>件</span><span>事業用 <%= commercial %>件</span></div>
<section class="town-property-grid" aria-label="掲載物件">
<% listing.forEach(p=>{ %>
<article class="card">
<a href="/property/<%= encodeURIComponent(p.id) %>">
<% if(p.photos && p.photos[0]){ %><img loading="lazy" src="/uploads/<%= p.photos[0] %>" alt="<%= p.title %>の物件写真"><% } else { %><div style="aspect-ratio:4/3;background:#e9f0ec;display:grid;place-items:center">写真準備中</div><% } %>
<span class="muted"><%= p.category||'' %>・<%= p.type||'' %></span>
<h3><%= p.title %></h3>
<div class="price"><%= money(p.price) %>円/月</div>
<p><%= p.layout||'' %> <%= p.area ? p.area+'㎡' : '' %></p>
<p><%= p.city %><%= p.address %></p>
<p class="town-station"><% if(stationName(p)){ %>🚉 <%= stationName(p) %><% if(stationWalk(p)!=null){ %> 徒歩<%= stationWalk(p) %>分<% } %><% }else{ %>最寄り駅：未登録<% } %></p>
</a>
</article>
<% }) %>
</section>
<%
// 公開物件の登録データのみを使い、地域情報を捏造しない
const stationMap=new Map();
for(const property of listing){
 const name=stationName(property);
 if(!name)continue;
 const item=stationMap.get(name)||{name,count:0,walks:[]};
 item.count++;
 const walk=Number(property.walkMinutes);
 if(property.walkMinutes!=='' && property.walkMinutes!=null && Number.isFinite(walk) && walk>0)item.walks.push(walk);
 stationMap.set(name,item);
}
const stations=[...stationMap.values()].sort((a,b)=>b.count-a.count);
const facilities=[];
const facilityKeys=new Set();
for(const property of listing){
 if(!Array.isArray(property.facilities))continue;
 for(const f of property.facilities){
  const name=String(f.name||'').trim();
  if(!name)continue;
  const category=String(f.category||'周辺施設').trim();
  const key=category+'|'+name;
  if(facilityKeys.has(key))continue;
  facilityKeys.add(key);
  facilities.push({name,category});
 }
}
const locationQuery=encodeURIComponent(city+town);
%>
<section class="town-seo" aria-labelledby="access-guide">
<h2 id="access-guide"><%= city %><%= town %>の交通アクセス</h2>
<% if(stations.length){ %>
<p>掲載中の物件に登録されている最寄り駅情報です。駅からの距離や所要時間は各物件の詳細ページでご確認ください。</p>
<ul>
<% stations.forEach(s=>{ %><li><strong><%= s.name %></strong>：掲載物件 <%= s.count %>件<% if(s.walks.length){ %>（登録された徒歩分数 <%= Math.min(...s.walks) %>〜<%= Math.max(...s.walks) %>分）<% } %></li><% }) %>
</ul>
<% } else { %><p>現在、公開物件に最寄り駅の登録情報がありません。交通アクセスは各物件の詳細情報をご確認ください。</p><% } %>
</section>
<section class="town-seo" aria-labelledby="facility-guide">
<h2 id="facility-guide"><%= city %><%= town %>の周辺施設</h2>
<% if(facilities.length){ %>
<p>掲載物件に登録されている施設情報です。施設の営業状況・所在地・利用条件は訪問前にご確認ください。</p>
<ul><% facilities.slice(0,25).forEach(f=>{ %><li><%= f.category %>：<%= f.name %></li><% }) %></ul>
<% } else { %><p>周辺施設の登録情報はまだありません。下記の地図検索からスーパー・学校・病院などをお調べいただけます。</p><% } %>
<p><a href="https://www.google.com/maps/search/?api=1&amp;query=<%= locationQuery %>" target="_blank" rel="noopener noreferrer"><%= city %><%= town %>を地図で調べる（外部サイト）</a></p>
</section>
<section class="town-seo" aria-labelledby="area-guide">
<h2 id="area-guide"><%= city %><%= town %>の地域・募集情報</h2>
<p>このページでは、<%= city %><%= town %>で現在公開されている賃貸物件を掲載しています。居住用 <%= residential %>件、事業用 <%= commercial %>件です。募集条件や空室状況は変更されることがあります。</p>
<p>周辺環境は物件の位置によって異なります。内見前に通勤・通学経路、買い物施設、駐車場などをご確認ください。</p>
</section>
<section class="town-seo" aria-labelledby="town-guide">
<h2 id="town-guide"><%= city %><%= town %>で賃貸物件を探す方へ</h2>
<p>JBP RENTALでは、<%= city %><%= town %>の賃貸マンション・アパート・一戸建てなどの居住用物件に加え、貸店舗・貸事務所などの事業用物件もご紹介しています。掲載情報は募集状況に応じて更新されます。</p>
<p>現在このページに掲載されている物件は<%= count %>件です。家賃、間取り、面積、最寄り駅などを比較し、気になる物件の詳細をご確認ください。条件に合う物件がない場合は、他の町名や市区町村もご覧いただけます。</p>
<p><a href="/properties">賃貸物件を条件から探す</a> ／ <a href="/areas">ほかの町名から探す</a></p>
</section>
</main>
<footer><div class="wrap">ジャパンベストパートナーズ株式会社｜JBP RENTAL</div></footer>
</body></html>
