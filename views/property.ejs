<!doctype html><html lang="ja"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= p.title %>｜JBP RENTAL</title><meta name="description" content="<%= p.city %><%= p.address %>の賃貸物件 <%= p.title %>"><link rel="canonical" href="<%= origin() + canonical %>"><link rel="stylesheet" href="/style.css"></head><body><header><div class="wrap"><strong>JBP RENTAL｜ジャパンベストパートナーズ株式会社</strong><nav><a href="/">ホーム</a><a href="/properties">賃貸物件検索</a><a href="/areas">町名から探す</a><a href="/owners">オーナー様へ</a></nav></div></header><main class="wrap"><h1><%= p.title %></h1><p><%= p.city %><%= p.address %> / <%= p.type %></p><div class="grid"><% (p.photos||[]).forEach(f=>{ %><div class="card"><img style="width:100%" src="/uploads/<%= f %>"></div><% }) %></div><div class="panel"><div class="price"><%= money(p.price) %>円/月</div><p>管理費：<%= money(p.managementFee) %>円　敷金：<%= p.deposit %>　礼金：<%= p.keyMoney %></p><p>間取り：<%= p.layout %>　面積：<%= p.area %>㎡　最寄駅：<%= p.station %></p><p><%= p.description %></p></div><h2>お問い合わせ</h2><form class="panel" action="/inquiry" method="post"><input type="hidden" name="propertyId" value="<%= p.id %>"><label>お名前<input name="name" required></label><label>メール<input name="email" type="email"></label><label>電話<input name="phone"></label><label>内容<textarea name="message"></textarea></label><button>送信</button></form></main><footer><div class="wrap">ジャパンベストパートナーズ株式会社｜JBP RENTAL</div></footer></body></html>