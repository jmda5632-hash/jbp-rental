<!doctype html><html lang="ja"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>賃貸物件一覧｜JBP RENTAL</title><meta name="description" content="市川市・船橋市・浦安市・鎌ヶ谷市の賃貸物件検索"><link rel="canonical" href="https://jbp-rental.onrender.com/properties"><link rel="stylesheet" href="/style.css"><link rel="stylesheet" href="/jbp-redesign.css"></head><body><header class="jbp-header"><div class="jbp-wrap jbp-head"><a class="jbp-logo" href="/">⌂ JBP RENTAL<small>ジャパンベストパートナーズ株式会社</small></a><nav class="jbp-nav"><a href="/">ホーム</a><a href="/properties">賃貸物件検索</a><a href="/areas">町名から探す</a><a href="/owners">オーナー様へ</a></nav></div></header><main class="jbp-wrap"><section class="jbp-section"><h1>賃貸物件検索</h1><form class="jbp-search" action="/properties" method="get"><div class="jbp-tabs"><button type="button" class="active" data-category="居住用">⌂ 居住用</button><button type="button" data-category="事業用">▦ 事業用</button></div><input type="hidden" name="category" id="jbp-cat" value="居住用"><div class="jbp-fields"><label>エリア<select name="city"><option value="">すべて</option><option>市川市</option><option>船橋市</option><option>浦安市</option><option>鎌ヶ谷市</option></select></label><label>物件種別<select name="type" id="jbp-type"><option value="">すべて</option><option>賃貸マンション</option><option>賃貸アパート</option><option>賃貸戸建</option><option>テラスハウス</option></select></label><label>駅名・町名<input name="q" placeholder="キーワード"></label><label>家賃上限（円）<input name="maxPrice" type="number" min="0" placeholder="指定なし"></label></div><button class="jbp-submit">⌕ この条件で検索する</button></form><script>document.querySelectorAll('.jbp-tabs button').forEach(b=>b.onclick=()=>{document.querySelectorAll('.jbp-tabs button').forEach(x=>x.classList.remove('active'));b.classList.add('active');let c=b.dataset.category;document.getElementById('jbp-cat').value=c;document.getElementById('jbp-type').innerHTML='<option value="">すべて</option>'+(c==='居住用'?['賃貸マンション','賃貸アパート','賃貸戸建','テラスハウス']:['貸店舗','貸事務所','貸倉庫','貸地']).map(x=>'<option>'+x+'</option>').join('')});</script></section><section class="jbp-section"><div class="jbp-section-title"><h2>物件一覧（<%= properties.length %>件）</h2><a href="/areas">町名から探す ›</a></div><div class="jbp-grid"><% properties.forEach(p=>{ %><a class="jbp-card" href="/property/<%= p.id %>"><div class="jbp-card-photo"><% if(p.photos && p.photos[0]){ %><img loading="lazy" src="/uploads/<%= encodeURIComponent(p.photos[0]) %>" alt="<%= p.title %>"><% }else{ %>⌂ NO IMAGE<% } %></div><div class="jbp-card-body"><h3><%= p.title %></h3><span class="jbp-tag"><%= p.type %></span><div class="jbp-price"><%= (Number(p.price||0)/10000).toLocaleString('ja-JP',{maximumFractionDigits:2}) %>万円</div><p><%= p.layout||'間取り未登録' %><%= p.area?' '+p.area+'㎡':'' %></p><p><%= p.station||p.city %><%= p.walkMinutes?' 徒歩'+p.walkMinutes+'分':'' %></p></div></a><% }) %></div><% if(!properties.length){ %><p>条件に合う公開物件はありません。</p><% } %></section></main><footer class="jbp-footer"><div class="jbp-wrap">JBP RENTAL｜ジャパンベストパートナーズ株式会社</div></footer><nav class="jbp-bottom"><a href="/">⌂<br>ホーム</a><a href="/properties">⌕<br>物件検索</a><a href="/areas">♧<br>町名から</a><a href="/owners">✉<br>ご相談</a></nav></body></html>
