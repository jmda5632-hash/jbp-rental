<!doctype html><html lang="ja"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>賃貸物件一覧｜JBP RENTAL</title><meta name="description" content="市川市・船橋市・浦安市・鎌ヶ谷市の賃貸物件一覧"><link rel="canonical" href="<%= origin() + canonical %>"><link rel="stylesheet" href="/style.css"></head><body><header><div class="wrap"><strong>JBP RENTAL｜ジャパンベストパートナーズ株式会社</strong><nav><a href="/">ホーム</a><a href="/properties">賃貸物件検索</a><a href="/areas">町名から探す</a><a href="/owners">オーナー様へ</a></nav></div></header><main class="wrap"><h1>賃貸物件一覧</h1><form class="panel"><div class="grid"><label>キーワード<input name="q" value="<%= typeof filters==='undefined'?'':filters.q %>"></label><label>地域<select name="city"><option value="">すべて</option><% ['市川市','船橋市','浦安市','鎌ヶ谷市'].forEach(c=>{ %><option><%= c %></option><% }) %></select></label><label>用途<select name="category"><option value="">すべて</option><option>居住用</option><option>事業用</option></select></label><label>種別<select name="type"><option value="">すべて</option><% types.forEach(t=>{ %><option><%= t %></option><% }) %></select></label><label>家賃上限（円）<input type="number" name="maxPrice"></label></div><button>検索</button></form><p><%= properties.length %>件</p><div class="grid"><% properties.forEach(p=>{ %><div class="card"><a href="/property/<%= p.id %>"><% if(p.photos?.[0]){%><img src="/uploads/<%= p.photos[0] %>" alt="<%= p.title %>"><%}%><span class="muted"><%= p.category %>・<%= p.type %></span><h3><%= p.title %></h3><div class="price"><%= money(p.price) %>円/月</div><p><%= p.city %><%= p.address %></p></a></div><% }) %></div></main><footer><div class="wrap">ジャパンベストパートナーズ株式会社｜JBP RENTAL</div></footer></body></html>