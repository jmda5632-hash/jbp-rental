<!doctype html><html lang="ja"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><link rel="stylesheet" href="/style.css"><title>賃貸物件管理</title></head><body><main class="wrap"><h1>JBP RENTAL｜物件管理</h1><p><a class="btn" href="/admin/properties/new">＋物件追加<a class="btn" href="/admin/import-csv">CSV一括登録</a></a> <a class="btn" href="/admin/inquiries">お問い合わせ</a> <a class="btn" href="/" target="_blank">公開サイト</a></p><form method="post" action="/admin/logout"><button>ログアウト</button></form><form class="panel" method="get"><div class="grid"><label>キーワード<input name="q"></label><label>状態<select name="status"><option value="">すべて</option><% statuses.forEach(x=>{ %><option><%= x %></option><% }) %></select></label><label>種別<select name="type"><option value="">すべて</option><% types.forEach(x=>{ %><option><%= x %></option><% }) %></select></label><label>市区町村<input name="city"></label></div><button>絞り込み</button></form><form id="bulk" action="/admin/bulk-status" method="post" class="panel"><input type="hidden" name="selectedIds" id="selectedIds" value="[]"><label>選択物件を<select name="status"><% statuses.forEach(x=>{ %><option><%= x %></option><% }) %></select></label><button>一括保存</button> <button type="button" onclick="bulkDelete()">選択物件を一括削除</button></form><p>緑＝公開中、黄色＝完全一致の重複</p><div class="scroll"><table><thead><tr><th><input type="checkbox" id="all"></th><th>写真追加</th><th>物件名・番号</th><th>家賃</th><th>状態</th><th>操作</th></tr></thead><tbody><% properties.forEach(p=>{ %><tr class="<%= dup.has(p.id)?'dup':p.status==='公開'?'published':'' %>"><td><input class="selectProp" type="checkbox" value="<%= p.id %>"></td><td><div class="drop" data-id="<%= p.id %>"><% if(p.photos?.[0]){ %><img src="/uploads/<%= p.photos[0] %>"><% } %><div>写真をクリック/ドロップ</div><small><%= (p.photos||[]).length %>枚</small><input hidden type="file" accept="image/*" multiple></div></td><td><b><%= p.title %></b><br><%= p.propertyNo %><br><%= p.type %> / <%= p.city %></td><td><%= money(p.price) %>円</td><td><form method="post" action="/admin/properties/<%= p.id %>/status"><select name="status"><% statuses.forEach(x=>{ %><option <%= p.status===x?'selected':'' %>><%= x %></option><% }) %></select><button>保存</button></form></td><td><a class="btn" href="/admin/properties/<%= p.id %>/edit">編集</a><form method="post" action="/admin/properties/<%= p.id %>/delete" onsubmit="return confirm('削除しますか？')"><button>削除</button></form></td></tr><% }) %></tbody></table></div><h2>最新のお問い合わせ</h2><div class="scroll"><table><% inquiries.forEach(i=>{ %><tr><td><%= i.createdAt %></td><td><%= i.name %></td><td><%= i.phone %></td><td><%= i.message %></td></tr><% }) %></table></div></main><script>
const checks=[...document.querySelectorAll('.selectProp')],hidden=document.getElementById('selectedIds');function sync(){hidden.value=JSON.stringify(checks.filter(x=>x.checked).map(x=>x.value))}checks.forEach(x=>x.onchange=sync);document.getElementById('all').onchange=e=>{checks.forEach(x=>x.checked=e.target.checked);sync()};function bulkDelete(){sync();if(!JSON.parse(hidden.value).length)return alert('物件を選択してください');if(confirm('選択物件を完全削除しますか？')){const f=document.getElementById('bulk');f.action='/admin/bulk-delete';f.submit()}}
document.querySelectorAll('.drop').forEach(z=>{const i=z.querySelector('input');z.onclick=()=>i.click();z.ondragover=e=>e.preventDefault();z.ondrop=e=>{e.preventDefault();send(e.dataTransfer.files)};i.onchange=()=>send(i.files);async function send(files){if(!files.length)return;const fd=new FormData();[...files].forEach(f=>fd.append('photos',f));try{const res=await fetch('/admin/properties/'+z.dataset.id+'/photos-quick',{method:'POST',body:fd});const j=await res.json();if(!res.ok)throw Error(j.error);location.reload()}catch(e){alert(e.message)}}});
</script></body></html>
